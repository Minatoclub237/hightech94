{%- comment -%}
  Redirige l'ancien thème Shopify vers le nouveau site High Tech 94.
  À coller dans Boutique en ligne → Thèmes → … → Modifier le code → layout/theme.liquid,
  juste après la balise <head>. Remplacer VOTRE-DOMAINE.fr par l'adresse du nouveau site.
  Le panier, la caisse et le compte client restent sur Shopify (ils ne passent pas par le thème).
  Effet : le nom « High Tech » en haut de la page de paiement, les anciens liens Google et
  les liens partagés mènent tous vers la page équivalente du nouveau site.
{%- endcomment -%}
{%- assign nouveau_site = 'https://VOTRE-DOMAINE.fr' -%}
{%- unless request.design_mode -%}
<script>
  (function () {
    var p = location.pathname.replace(/\/+$/, '');
    var m, target = '/';
    var collections = { smartnest: 'maison', 'air-pur': 'air-pur', conduirego: 'auto', bureaupro: 'bureau' };
    var pages = ['a-propos', 'faq', 'livraison-retours', 'confiance', 'conditions-de-vente', 'confidentialite-donnees', 'mentions-legales'];
    var policies = { 'shipping-policy': 'shipping-policy', 'refund-policy': 'refund-policy', 'terms-of-service': 'conditions-de-vente', 'privacy-policy': 'confidentialite-donnees' };
    if (/^\/(cart|account|checkouts?|challenge|password)/.test(p)) return;
    if ((m = p.match(/\/products\/([^/]+)/))) target = '/produit/' + m[1] + '/';
    else if ((m = p.match(/^\/collections\/([^/]+)$/))) target = collections[m[1]] ? '/categorie/' + collections[m[1]] + '/' : '/categorie/';
    else if (p === '/collections') target = '/categorie/';
    else if ((m = p.match(/^\/pages\/([^/]+)$/))) target = pages.indexOf(m[1]) >= 0 ? '/page/' + m[1] + '/' : (m[1] === 'contact' ? '/#contact' : '/');
    else if ((m = p.match(/^\/policies\/([^/]+)$/))) target = policies[m[1]] ? '/page/' + policies[m[1]] + '/' : '/';
    location.replace('{{ nouveau_site }}' + target);
  })();
</script>
{%- endunless -%}
